# 로컬 개발: 이 파일을 .env.local 로 복사하고 값을 채운다. (.env.local 은 커밋하지 않음)
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 등록한다(Production·Preview 모두 체크).
#
# 값은 Supabase → Project Settings → API Keys 에서 복사한다.
#   변수 이름은 예전 키 이름(anon / service_role)을 따르지만, 새 키를 넣으면 된다.

# Project URL (https://<프로젝트ID>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_...)  ← 예전 이름: anon key. 브라우저에 공개돼도 되는 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...)  ← 예전 이름: service_role key. 서버 전용, 절대 NEXT_PUBLIC_ 를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=
