# 로컬 개발: 이 파일을 .env.local 로 복사하고 값을 채운다. (.env.local 은 커밋하지 않음)
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 등록한다.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 를 붙이지 말 것. (src/lib/supabase/admin.ts 에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=
